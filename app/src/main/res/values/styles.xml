<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">@dimen/size_24dp</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemTextAppearanceActive">@style/BottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText</item>
    </style>

    <style name="BottomNavText">
        <item name="android:textSize">@dimen/size_12sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/dehinted_razerf5_regular</item>
    </style>

    <style name="RoundedImageStyle" parent="Widget.MaterialComponents.ShapeableImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/small_icon_pad</item>
    </style>

    <style name="SearchBar" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@drawable/search_rounded</item>
        <item name="iconifiedByDefault">false</item>
    </style>

    <style name="SearchViewOverlay" parent="ThemeOverlay.AppCompat">
        <item name="android:textColorPrimary">@color/search_text_color</item>
        <item name="android:textColorHint">@color/search_hint_color</item>
        <item name="colorControlNormal">@color/search_icon_color</item>
    </style>

    <style name="styleButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/light_mode_txt</item>
        <item name="backgroundTint">@color/controlActivated</item>
        <item name="cornerRadius">@dimen/size_32dp</item>
        <item name="android:minHeight">@dimen/size_36dp</item>
        <item name="android:paddingStart">@dimen/size_24dp</item>
        <item name="android:paddingEnd">@dimen/size_24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/size_14sp</item>
        <item name="android:fontFamily">@font/dehinted_razerf5_regular</item>
    </style>

</resources>