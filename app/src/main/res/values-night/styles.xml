<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemTextAppearanceActive">@style/BottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText</item>
    </style>

    <style name="BottomNavText">
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SearchBar" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@drawable/search_rounded</item>
        <item name="iconifiedByDefault">false</item>
    </style>

    <style name="SearchViewOverlay" parent="ThemeOverlay.AppCompat">
        <item name="android:textColorPrimary">@color/search_text_color</item>
        <item name="android:textColorHint">@color/search_hint_color</item>
        <item name="colorControlNormal">@color/search_icon_color</item>
    </style>

</resources>